# Cache degli asset statici su Cloudflare Pages.
#
# I quattro file qui sotto sono referenziati nell'HTML con una query di
# versione (?v=...): cambiando quel valore cambia l'URL, quindi la cache
# viene invalidata da sola. Per questo possono avere durata lunga e
# "immutable". ATTENZIONE: se si modifica uno di questi file SENZA
# aggiornare il ?v= nell'HTML, i browser continueranno a servire la
# versione vecchia.
/styles.css
  Cache-Control: public, max-age=31536000, immutable

/logo-emblem.png
  Cache-Control: public, max-age=31536000, immutable

/logo-emblem-white.png
  Cache-Control: public, max-age=31536000, immutable

/ermanno-colazzo-perito-grafologo.jpg
  Cache-Control: public, max-age=31536000, immutable

# Le anteprime social non sono versionate: durata piu' breve, cosi' una
# sostituzione viene recepita entro una settimana.
/social-card.jpg
  Cache-Control: public, max-age=604800

/social-card.png
  Cache-Control: public, max-age=604800

# L'HTML resta rivalidato a ogni richiesta: il TTFB misurato e' 121 ms e
# un deploy deve essere visibile subito.
